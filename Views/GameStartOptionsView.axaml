<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ATC4_HQ.ViewModels"
             x:Class="ATC4_HQ.Views.GameStartOptionsView"
             x:DataType="vm:GameStartOptionsViewModel">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <Image Source="/Assets/ATC4.ico"
               Width="96"
               Height="96"
               Margin="0,0,0,12"
               HorizontalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <Button Command="{Binding Button1Command}"
                Width="260"
                Height="78"
                Padding="18,10"
                Background="{Binding AccentLightBrush}"
                BorderBrush="{Binding AccentBrush}"
                BorderThickness="2"
                CornerRadius="14">
            <StackPanel Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="启动游戏"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#111111"/>
                <TextBlock Text="{Binding CurrentGameVersionText}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="#99000000"/>
            </StackPanel>
        </Button>

        <Button Command="{Binding SelectGameCommand}"
                Width="260"
                Height="48"
                Padding="16,6"
                Background="{Binding AccentLightBrush}"
                BorderBrush="{Binding AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="12">
            <TextBlock Text="选择游戏"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="#111111"/>
        </Button>
    </StackPanel>
</UserControl>