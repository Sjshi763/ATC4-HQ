<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:ATC4_HQ.ViewModels"
             xmlns:vm="clr-namespace:ATC4_HQ.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="680"
             d:DesignHeight="520"
             x:Class="ATC4_HQ.Views.InstallGameData"
             x:DataType="viewmodels:InstallGameDataViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Margin="18"
                Padding="24"
                CornerRadius="18">
            <Grid RowDefinitions="Auto,*">
            <StackPanel Spacing="6">
                <TextBlock Text="安装"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#000000" />
                <TextBlock Text="选择完整 ATC4 分卷压缩包文件夹，并按步骤创建可启动的服务器。"
                           FontSize="13"
                           Foreground="#000000" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,26,0,0"
                  ColumnDefinitions="48,*"
                  RowDefinitions="Auto,Auto,Auto">

                <!-- 步骤 1 -->
                <Grid Grid.Row="0"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="48,*"
                      Margin="0,0,0,24">
                    <Border Grid.Column="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            HorizontalAlignment="Left">
                        <TextBlock Text="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#000000" />
                    </Border>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="14">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="选择完整安装包文件夹"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#000000" />
                                <TextBlock Text="该文件夹必须包含全部分卷，缺少任意一个都会阻止安装。"
                                           TextWrapping="Wrap"
                                           Foreground="#000000" />
                                <TextBlock Text="{Binding RequiredArchivePartsText}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#000000" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="WhereIsTheGames"
                                         Grid.Column="0"
                                         Height="34"
                                         Watermark="请选择包含 ATC4 分卷压缩包的文件夹"
                                         Text="{Binding GamePath}"
                                         VerticalAlignment="Center" />
                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Content="浏览文件夹"
                                        Height="34"
                                        Margin="10,0,0,0"
                                        Padding="16,0"
                                        Command="{Binding FindFileCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding ArchiveValidationMessage}"
                                       TextWrapping="Wrap"
                                Foreground="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AccentLightBrush}"
                                FontSize="12" />

                            <TextBlock Text="{Binding SsdWarning}"
                                       Foreground="#000000"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 步骤 2 -->
                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="48,*"
                      Margin="0,0,0,24">
                    <Border Grid.Column="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            HorizontalAlignment="Left">
                        <TextBlock Text="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#000000" />
                    </Border>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="14">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="命名游戏"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#000000" />
                                <TextBlock Text="安装完成后会将名称写入 GameData.ini，方便后续在启动器内识别。"
                                           TextWrapping="Wrap"
                                           Foreground="#000000" />
                            </StackPanel>

                            <TextBox x:Name="TheGameName"
                                     Height="34"
                                     Watermark="取个名字方便找到它"
                                     Text="{Binding GameName}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 步骤 3 -->
                <Grid Grid.Row="2"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="48,*">
                    <Border Grid.Column="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            HorizontalAlignment="Left">
                        <TextBlock Text="3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#000000" />
                    </Border>

                    <Border Grid.Column="1"
                            Padding="18"
                            CornerRadius="14">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="解压并写入配置"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#000000" />
                                <TextBlock Text="启动器会使用支持分卷 ZIP 的解压库，从 ATC4.zip 读取全部分段并保存公共路径配置。"
                                           TextWrapping="Wrap"
                                           Foreground="#000000" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Right">
                                <Button Content="清除"
                                        Command="{Binding CancelCommand}"
                                        Width="96"
                                        Height="36" />
                                <Button Content="开始安装"
                                        Command="{Binding SaveCommand}"
                                        Width="120"
                                        Height="36"
                                         Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AccentBrush}"
                                         Foreground="#000000" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
